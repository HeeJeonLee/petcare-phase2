# 새론금융대부중개 AI 에이전트 환경변수 설정 파일
# =====================================================
# 이 파일을 ".env.template" → ".env" 로 복사한 후
# 각 항목의 "여기에_입력" 부분을 실제 값으로 바꾸세요.
# .env 파일은 절대 GitHub에 올리면 안 됩니다! (비밀번호 유출 위험)
# =====================================================

# ── Claude AI (이미 설정됨) ──────────────────────────
ANTHROPIC_API_KEY=여기에_Claude_API_키_입력

# ── 텔레그램 봇 (대표님 핸드폰 알림) ─────────────────
# 텔레그램 앱 → @BotFather → /newbot → 토큰 받기
TELEGRAM_BOT_TOKEN=여기에_텔레그램_봇_토큰_입력
# 텔레그램 → @userinfobot 에게 메시지 보내면 Chat ID 확인
TELEGRAM_CHAT_ID=여기에_텔레그램_채팅ID_입력

# ── 인스타그램 ───────────────────────────────────────
# Facebook 개발자 → Graph API Explorer → 토큰 발급
INSTAGRAM_ACCESS_TOKEN=여기에_인스타그램_액세스_토큰_입력
INSTAGRAM_USER_ID=여기에_인스타그램_사용자ID_입력

# ── 페이스북 페이지 ──────────────────────────────────
FACEBOOK_ACCESS_TOKEN=여기에_페이스북_액세스_토큰_입력
FACEBOOK_PAGE_ID=여기에_페이스북_페이지ID_입력

# ── 네이버 블로그 ────────────────────────────────────
# developers.naver.com → 애플리케이션 등록
NAVER_CLIENT_ID=여기에_네이버_클라이언트ID_입력
NAVER_CLIENT_SECRET=여기에_네이버_클라이언트_시크릿_입력
NAVER_BLOG_ID=여기에_네이버_블로그ID_입력

# ── 카카오 채널 ──────────────────────────────────────
# developers.kakao.com → 앱 생성 → 액세스 토큰
KAKAO_ACCESS_TOKEN=여기에_카카오_액세스_토큰_입력
KAKAO_CHANNEL_ID=여기에_카카오_채널ID_입력

# ── 이메일 알림 (saeloan 웹사이트용) ─────────────────
# Gmail 계정 → 구글 앱 비밀번호 생성
SMTP_USER=여기에_Gmail주소_입력@gmail.com
SMTP_PASS=여기에_앱비밀번호_16자리_입력
NOTIFY_EMAIL=hejunl@hanmail.net
